{
    "manifest_version": 3,
    "name": "Terp Rater",
    "version": "0.0.2",
    "description": "Enhance UMD Testudo with PlanetTerp GPA, professor ratings, waitlist counts, live seat tags, section sorting, and bookmarks.",
    "icons": {
        "16" : "assets/favicon-16.png",
        "32" : "assets/favicon-32.png",
        "48" : "assets/favicon-48.png",
        "128" : "assets/favicon-128.png"
    },
    "action": {
        "default_popup": "html/popup.html",
        "default_title": "Terp Rater Bookmarks",
        "default_icon": {
            "16": "assets/favicon-16.png",
            "32": "assets/favicon-32.png",
            "48": "assets/favicon-48.png"
        }
    },
    "permissions": ["storage"],
    "content_scripts": [
        {
            "matches": ["https://app.testudo.umd.edu/soc/*"],
            "css": ["css/global.css", "css/tooltip.css", "css/modal.css", "css/tag.css", "css/sort.css"],
            "js": ["js/tag.js", "js/tooltip.js", "js/modal.js", "js/courseUtils.js", "js/sort.js", "js/bookmark.js", "js/content.js"]
        }
    ],
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
    },
    "host_permissions": ["https://planetterp.com/api/v1/*"],
    "web_accessible_resources": [
        {
            "resources": [ "assets/*.ttf" ],
            "matches": [ "https://app.testudo.umd.edu/*" ]
        },
        {
            "resources": [ "assets/*.svg" ],
            "matches": [ "https://app.testudo.umd.edu/*" ]
        },
        {
            "resources": [ "assets/*.png" ],
            "matches": [ "https://app.testudo.umd.edu/*" ]
        }
      ]
}